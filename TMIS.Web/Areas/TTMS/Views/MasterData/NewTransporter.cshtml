@model NewTransporterViewModel

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link href="~/css/input-text-upper.css" rel="stylesheet" />
}

@section VendorScripts {
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
}

@section PageScripts {
    <script src="~/js/form-layouts.js"></script>
    <script src="~/custom/input-text-upper.js"></script>
}

<!-- Multi Column with Form Separator -->
<div class="card mb-6">
    <h5 class="card-header page-header">
        New Transporter
    </h5>
    <form asp-action="NewTransporter" method="post" class="card-body" id="myForm" enctype="multipart/form-data">
        <div class="row g-2">

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.NIC" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.NIC"></label>
                    <span asp-validation-for="@Model.Transporter.NIC" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.TransporterName" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.TransporterName"></label>
                    <span asp-validation-for="@Model.Transporter.TransporterName" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.PhoneMobile" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.PhoneMobile"></label>
                    <span asp-validation-for="@Model.Transporter.PhoneMobile" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.AccountNo" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.AccountNo"></label>
                    <span asp-validation-for="@Model.Transporter.AccountNo" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.AccountHolderName" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.AccountHolderName"></label>
                    <span asp-validation-for="@Model.Transporter.AccountHolderName" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.Bank" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.Bank"></label>
                    <span asp-validation-for="@Model.Transporter.Bank" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.Branch" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.Branch"></label>
                    <span asp-validation-for="@Model.Transporter.Branch" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.BankCode" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.BankCode"></label>
                    <span asp-validation-for="@Model.Transporter.BankCode" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Transporter.BranchCode" type="text" class="form-control" />
                    <label asp-for="@Model.Transporter.BranchCode"></label>
                    <span asp-validation-for="@Model.Transporter.BranchCode" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="pt-1">
                <button type="submit" class="btn btn-primary me-1">Submit</button>
                <button type="reset" class="btn btn-primary me-1">Clear</button>
                <a asp-controller="MasterData" asp-action="Transporters" class="btn btn-outline-secondary">Back to List</a>
            </div>

        </div>
    </form>
</div>
