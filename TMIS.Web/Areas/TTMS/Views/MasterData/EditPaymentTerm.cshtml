@model NewPaymentTermViewModel

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link href="~/css/input-text-upper.css" rel="stylesheet" />
}

@section VendorScripts {
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
}

@section PageScripts {
    <script src="~/js/form-layouts.js"></script>
    <script src="~/custom/input-text-upper.js"></script>
}

<!-- Multi Column with Form Separator -->
<div class="card mb-6">
    <h5 class="card-header page-header">
        Edit Payment Term
    </h5>
    <form asp-action="EditPaymentTerm" method="post" class="card-body" id="myForm" enctype="multipart/form-data">
        <div class="row g-2">
            <input asp-for="@Model.PaymentTerm.PaymentTermId" type="hidden" />

            <div class="col-md-4">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.PaymentTerm.PaymentTermName" type="text" class="form-control" />
                    <label asp-for="@Model.PaymentTerm.PaymentTermName"></label>
                    <span asp-validation-for="@Model.PaymentTerm.PaymentTermName" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-8">
                <div class="form-floating form-floating-outline">
                    <textarea asp-for="@Model.PaymentTerm.Description" class="form-control" style="height: 58px;"></textarea>
                    <label asp-for="@Model.PaymentTerm.Description"></label>
                    <span asp-validation-for="@Model.PaymentTerm.Description" class="customerError text-warning"></span>
                </div>
            </div>

            <div class="col-md-2">
                <div class="list-group">
                    <label class="list-group-item w-100">
                        <span class="form-check mb-0">
                            <input asp-for="@Model.PaymentTerm.IsActive" class="form-check-input me-4" type="checkbox">
                            Is Active
                        </span>
                    </label>
                </div>
            </div>

            <div class="pt-1">
                <button type="submit" class="btn btn-primary me-1">Submit</button>
                <a asp-controller="MasterData" asp-action="PaymentTerms" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>
