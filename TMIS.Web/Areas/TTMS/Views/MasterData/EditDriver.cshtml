@model NewDriverViewModel

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link href="~/css/input-text-upper.css" rel="stylesheet" />
}

@section VendorScripts {
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
}

@section PageScripts {
    <script src="~/js/form-layouts.js"></script>
    <script src="~/custom/input-text-upper.js"></script>
}

<!-- Multi Column with Form Separator -->
<div class="card mb-6">
    <h5 class="card-header page-header">
        Edit Driver
    </h5>
    <form asp-action="EditDriver" method="post" class="card-body" id="myForm" enctype="multipart/form-data">
        <div class="row g-2">
            <input asp-for="@Model.Driver.DriverId" type="hidden" />           
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Driver.DriverName" type="text" class="form-control" />
                    <label asp-for="@Model.Driver.DriverName"></label>
                    <span asp-validation-for="@Model.Driver.DriverName" class="customerError text-warning"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Driver.NIC" type="text" class="form-control" />
                    <label asp-for="@Model.Driver.NIC"></label>
                    <span asp-validation-for="@Model.Driver.NIC" class="customerError text-warning"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Driver.LicenseNo" type="text" class="form-control" />
                    <label asp-for="@Model.Driver.LicenseNo"></label>
                    <span asp-validation-for="@Model.Driver.LicenseNo" class="customerError text-warning"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-floating form-floating-outline">
                    <input asp-for="@Model.Driver.PhoneMobile" type="text" class="form-control" />
                    <label asp-for="@Model.Driver.PhoneMobile"></label>
                    <span asp-validation-for="@Model.Driver.PhoneMobile" class="customerError text-warning"></span>
                </div>
            </div>          
            <div class="col-md-2">
                <div class="list-group">
                    <label class="list-group-item w-100">
                        <span class="form-check mb-0">
                            <input asp-for="@Model.Driver.IsActive" class="form-check-input me-4" type="checkbox">
                            Is Active
                        </span>
                    </label>
                </div>
            </div>
            <div class="pt-1">
                <button type="submit" class="btn btn-primary me-1">Submit</button>
                <a asp-controller="MasterData" asp-action="Drivers" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>
