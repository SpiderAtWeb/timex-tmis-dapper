@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link href="~/vendor/libs/toastr/toastr.css" rel="stylesheet" />
}

@section VendorScripts {
    <script src="~/custom/tables-datatables-autowidth-noorder.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
    <script src="~/custom/loading-hide.js"></script>
    <script src="~/vendor/libs/toastr/toastr.js"></script>
}

@section PageScripts {
    <script src="~/js/form-layouts.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize date to current month
            var today = new Date();
            var currentMonth = today.toISOString().substring(0, 7);
            $('#monthSelect').val(currentMonth);
            $('#effectiveDate').val(today.toISOString().substring(0, 10));

            // Load vehicles, destinations, employees, payment methods
            loadMasterData();

            // Load Attendance Button Click
            $('#loadAttendance').click(function() {
                var vehicleId = $('#vehicleSelect').val();
                var month = $('#monthSelect').val();

                if (!vehicleId || !month) {
                    Swal.fire('Warning', 'Please select vehicle and month', 'warning');
                    return;
                }

                loadAttendanceGrid(vehicleId, month);
            });

            // Add Employee to Allocation
            $('#addEmployeeBtn').click(function() {
                var employeeId = $('#employeeSelect').val();
                var employeeName = $('#employeeSelect option:selected').text();

                if (!employeeId) {
                    Swal.fire('Warning', 'Please select an employee', 'warning');
                    return;
                }

                var listItem = '<li class="list-group-item d-flex justify-content-between align-items-center" data-employee-id="' + employeeId + '">' +
                    employeeName +
                    '<button type="button" class="btn btn-sm btn-danger remove-employee"><i class="fas fa-trash"></i></button>' +
                    '</li>';

                $('#allocatedEmployeesList').append(listItem);
                $('#employeeSelect').val('');
            });

            // Remove Employee from Allocation
            $(document).on('click', '.remove-employee', function() {
                $(this).closest('li').remove();
            });

            // Save Vehicle Allocation
            $('#saveAllocationBtn').click(function() {
                var vehicleId = $('#allocVehicle').val();
                var destinationId = $('#allocDestination').val();
                var employees = [];

                $('#allocatedEmployeesList li').each(function() {
                    employees.push($(this).data('employee-id'));
                });

                if (!vehicleId || !destinationId || employees.length === 0) {
                    Swal.fire('Warning', 'Please complete all fields and add at least one employee', 'warning');
                    return;
                }

                // AJAX call to save allocation
                $.ajax({
                    url: '@Url.Action("SaveVehicleAllocation", "DailyTours")',
                    type: 'POST',
                    data: JSON.stringify({
                        vehicleId: vehicleId,
                        destinationId: destinationId,
                        employeeIds: employees
                    }),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Success', 'Vehicle allocation saved successfully', 'success');
                            $('#vehicleAllocationModal').modal('hide');
                            $('#vehicleAllocationForm')[0].reset();
                            $('#allocatedEmployeesList').empty();
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    }
                });
            });

            // Save Payment Term
            $('#savePaymentTermBtn').click(function() {
                var vehicleId = $('#paymentVehicle').val();
                var paymentMethodId = $('#paymentMethod').val();
                var cost = $('#cost').val();
                var effectiveDate = $('#effectiveDate').val();

                if (!vehicleId || !paymentMethodId || !cost || !effectiveDate) {
                    Swal.fire('Warning', 'Please complete all fields', 'warning');
                    return;
                }

                // AJAX call to save payment term
                $.ajax({
                    url: '@Url.Action("SavePaymentTerm", "DailyTours")',
                    type: 'POST',
                    data: JSON.stringify({
                        vehicleId: vehicleId,
                        paymentMethodId: paymentMethodId,
                        cost: cost,
                        effectiveDate: effectiveDate
                    }),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Success', 'Payment term saved successfully', 'success');
                            loadPaymentTerms(vehicleId);
                            $('#cost').val('');
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    }
                });
            });

            // Load Payment Terms when vehicle selected
            $('#paymentVehicle').change(function() {
                var vehicleId = $(this).val();
                if (vehicleId) {
                    loadPaymentTerms(vehicleId);
                }
            });

            // Save Daily Tours
            $('#dailyToursForm').submit(function(e) {
                e.preventDefault();

                var vehicleId = $('#vehicleSelect').val();
                var month = $('#monthSelect').val();
                var attendanceData = [];

                $('#attendanceTable tbody tr').each(function() {
                    var employeeId = $(this).data('employee-id');
                    var row = [];

                    $(this).find('input[type="checkbox"]').each(function() {
                        row.push({
                            date: $(this).data('date'),
                            isPresent: $(this).is(':checked')
                        });
                    });

                    attendanceData.push({
                        employeeId: employeeId,
                        attendance: row
                    });
                });

                // AJAX call to save attendance
                $.ajax({
                    url: '@Url.Action("SaveDailyTours", "DailyTours")',
                    type: 'POST',
                    data: JSON.stringify({
                        vehicleId: vehicleId,
                        month: month,
                        attendanceData: attendanceData
                    }),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Success', 'Attendance saved successfully', 'success');
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    }
                });
            });

            function loadMasterData() {
                // Load Vehicles
                $.get('@Url.Action("GetVehicles", "DailyTours")', function(data) {
                    var options = '<option value="">-- Select Vehicle --</option>';
                    $.each(data, function(i, item) {
                        options += '<option value="' + item.VehicleId + '">' + item.VehicleNumber + ' - ' + item.VehicleName + '</option>';
                    });
                    $('#vehicleSelect, #allocVehicle, #paymentVehicle').html(options);
                });

                // Load Destinations
                $.get('@Url.Action("GetDestinations", "DailyTours")', function(data) {
                    var options = '<option value="">-- Select Destination --</option>';
                    $.each(data, function(i, item) {
                        options += '<option value="' + item.DestinationId + '">' + item.DestinationName + '</option>';
                    });
                    $('#allocDestination').html(options);
                });

                // Load Employees
                $.get('@Url.Action("GetEmployees", "DailyTours")', function(data) {
                    var options = '<option value="">-- Select Employee --</option>';
                    $.each(data, function(i, item) {
                        options += '<option value="' + item.EmployeeId + '">' + item.EmployeeCode + ' - ' + item.EmployeeName + '</option>';
                    });
                    $('#employeeSelect').html(options);
                });

                // Load Payment Methods
                $.get('@Url.Action("GetPaymentMethods", "DailyTours")', function(data) {
                    var options = '<option value="">-- Select Payment Method --</option>';
                    $.each(data, function(i, item) {
                        options += '<option value="' + item.PaymentMethodId + '">' + item.PaymentMethodName + '</option>';
                    });
                    $('#paymentMethod').html(options);
                });
            }

            function loadAttendanceGrid(vehicleId, month) {
                $.ajax({
                    url: '@Url.Action("GetAttendanceGrid", "DailyTours")',
                    type: 'GET',
                    data: { vehicleId: vehicleId, month: month },
                    success: function(response) {
                        if (response.success) {
                            buildAttendanceTable(response.employees, response.days, response.attendance);
                            $('#attendanceTableContainer').show();
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    }
                });
            }

            function buildAttendanceTable(employees, days, attendance) {
                var thead = '<tr><th style="position: sticky; left: 0; background-color: #343a40; z-index: 10;">Employee</th>';

                $.each(days, function(i, day) {
                    thead += '<th class="text-center">' + day + '</th>';
                });
                thead += '</tr>';

                $('#attendanceTable thead').html(thead);

                var tbody = '';
                $.each(employees, function(i, emp) {
                    tbody += '<tr data-employee-id="' + emp.EmployeeId + '">';
                    tbody += '<td style="position: sticky; left: 0; background-color: white; z-index: 5;"><strong>' + emp.EmployeeName + '</strong></td>';

                    $.each(days, function(j, day) {
                        var date = month + '-' + (day < 10 ? '0' + day : day);
                        var isChecked = attendance[emp.EmployeeId] && attendance[emp.EmployeeId][date] ? 'checked' : '';

                        tbody += '<td class="text-center"><input type="checkbox" data-date="' + date + '" ' + isChecked + ' /></td>';
                    });

                    tbody += '</tr>';
                });

                $('#attendanceTable tbody').html(tbody);
            }

            function loadPaymentTerms(vehicleId) {
                $.ajax({
                    url: '@Url.Action("GetPaymentTerms", "DailyTours")',
                    type: 'GET',
                    data: { vehicleId: vehicleId },
                    success: function(data) {
                        var rows = '';
                        $.each(data, function(i, item) {
                            rows += '<tr>' +
                                '<td>' + item.PaymentMethodName + '</td>' +
                                '<td>' + item.Cost + '</td>' +
                                '<td>' + item.EffectiveDate + '</td>' +
                                '<td><button type="button" class="btn btn-sm btn-danger" onclick="deletePayment(' + item.VehiclePaymentId + ')"><i class="fas fa-trash"></i></button></td>' +
                                '</tr>';
                        });
                        $('#currentPaymentsList').html(rows);
                    }
                });
            }

            window.deletePayment = function(id) {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeletePaymentTerm", "DailyTours")',
                            type: 'POST',
                            data: { id: id },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Payment term has been deleted.', 'success');
                                    loadPaymentTerms($('#paymentVehicle').val());
                                }
                            }
                        });
                    }
                });
            };

            $('#clearForm').click(function() {
                $('#dailyToursForm')[0].reset();
                $('#attendanceTableContainer').hide();
            });
        });
    </script>
}

@section PageStyles {
    <style>
        .table-responsive {
            overflow-x: auto;
        }

        #attendanceTable {
            white-space: nowrap;
        }

            #attendanceTable td, #attendanceTable th {
                min-width: 50px;
            }

            #attendanceTable input[type="checkbox"] {
                transform: scale(1.2);
                cursor: pointer;
            }

        .list-group-item {
            transition: background-color 0.2s;
        }

            .list-group-item:hover {
                background-color: #f8f9fa;
            }
    </style>
}

@* ************** Content ************** *@

<!-- Modal -->
@await Html.PartialAsync("_Loading")
<div class="panelDiv">
    <div class="card">
        <h5 class="card-header page-header">Tours Transaction</h5>
        <div class="card-body">
            <!-- Action Buttons -->
            <div class="row mb-3">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#vehicleAllocationModal">
                        <i class="fas fa-users"></i> Vehicle Employee Allocation
                    </button>
                    <button type="button" class="btn btn-success ml-2" data-toggle="modal" data-target="#paymentTermModal">
                        <i class="fas fa-dollar-sign"></i> Vehicle Payment Term Allocation
                    </button>
                </div>
            </div>

            <!-- Main Daily Tours Form -->
            <div class="card">
                <div class="card-body">
                    <form id="dailyToursForm">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="vehicleSelect">Select Vehicle:</label>
                                    <select id="vehicleSelect" class="form-control" required>
                                        <option value="">-- Select Vehicle --</option>
                                        @* Populate from controller *@
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="monthSelect">Select Month:</label>
                                    <input type="month" id="monthSelect" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <button type="button" id="loadAttendance" class="btn btn-info btn-block">
                                        Load Attendance
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Attendance Table -->
                        <div id="attendanceTableContainer" style="display:none;">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="attendanceTable">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th style="position: sticky; left: 0; background-color: #343a40; z-index: 10;">Employee</th>
                                            <!-- Days will be dynamically generated -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Rows will be dynamically generated -->
                                    </tbody>
                                </table>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fas fa-save"></i> Save Attendance
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-lg ml-2" id="clearForm">
                                        <i class="fas fa-times"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Vehicle Employee Allocation Modal -->
        <div class="modal fade" id="vehicleAllocationModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Vehicle Employee Allocation</h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="vehicleAllocationForm">
                            <div class="form-group">
                                <label for="allocVehicle">Select Vehicle:</label>
                                <select id="allocVehicle" class="form-control" required>
                                    <option value="">-- Select Vehicle --</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="allocDestination">Vehicle Destination:</label>
                                <select id="allocDestination" class="form-control" required>
                                    <option value="">-- Select Destination --</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Add Employees:</label>
                                <div class="input-group mb-2">
                                    <select id="employeeSelect" class="form-control">
                                        <option value="">-- Select Employee --</option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-primary" id="addEmployeeBtn">
                                            <i class="fas fa-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Allocated Employees:</label>
                                <div class="border p-2" style="min-height: 200px; max-height: 300px; overflow-y: auto;">
                                    <ul class="list-group" id="allocatedEmployeesList">
                                        <!-- Dynamically populated -->
                                    </ul>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="saveAllocationBtn">Save Allocation</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vehicle Payment Term Modal -->
        <div class="modal fade" id="paymentTermModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Vehicle Payment Term Allocation</h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form id="paymentTermForm">
                            <div class="form-group">
                                <label for="paymentVehicle">Select Vehicle:</label>
                                <select id="paymentVehicle" class="form-control" required>
                                    <option value="">-- Select Vehicle --</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="paymentMethod">Payment Method:</label>
                                <select id="paymentMethod" class="form-control" required>
                                    <option value="">-- Select Payment Method --</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="cost">Cost:</label>
                                <input type="number" step="0.01" id="cost" class="form-control" placeholder="Enter cost" required />
                            </div>
                            <div class="form-group">
                                <label for="effectiveDate">Effective Date:</label>
                                <input type="date" id="effectiveDate" class="form-control" required />
                            </div>
                            <div class="form-group">
                                <label>Current Payment Allocations:</label>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Payment Method</th>
                                                <th>Cost</th>
                                                <th>Effective Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="currentPaymentsList">
                                            <!-- Dynamically populated -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="savePaymentTermBtn">Save Payment Term</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

